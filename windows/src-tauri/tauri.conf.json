{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Contador de tokens",
  "version": "0.1.0",
  "identifier": "com.contadortokens.escritorio",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tokens",
        "width": 340,
        "height": 600,
        "minWidth": 300,
        "minHeight": 260,
        "resizable": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://*.supabase.co https://*.supabase.in; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
